<?xml version="1.0" encoding="UTF-8"?><sqlb_project><db path="EMS.db" readonly="0" foreign_keys="1" case_sensitive_like="0" temp_store="0" wal_autocheckpoint="1000" synchronous="2"/><attached/><window><main_tabs open="structure browser pragmas query" current="3"/></window><tab_structure><column_width id="0" width="300"/><column_width id="1" width="0"/><column_width id="2" width="100"/><column_width id="3" width="3221"/><column_width id="4" width="0"/><expanded_item id="0" parent="1"/><expanded_item id="1" parent="1"/><expanded_item id="2" parent="1"/><expanded_item id="3" parent="1"/></tab_structure><tab_browse><table title="change_logs" custom_title="0" dock_id="1" table="4,11:mainchange_logs"/><dock_state state="000000ff00000000fd00000001000000020000000000000000fc0100000001fb000000160064006f0063006b00420072006f00770073006500310100000000ffffffff0000011300ffffff000000000000000000000004000000040000000800000008fc00000000"/><default_encoding codec=""/><browse_table_settings/></tab_browse><tab_sql><sql name="SQL 1*">-- Backup the original tables (optional but recommended)
CREATE TABLE leads_backup AS SELECT * FROM leads;
CREATE TABLE customers_backup AS SELECT * FROM customers;

-- Drop the original tables (after backup)
DROP TABLE leads;

-- Recreate leads table with new constraints
CREATE TABLE leads (
    employeeLeadId TEXT PRIMARY KEY,
    employeeId TEXT,
    employeeName TEXT,
    employeeContactNo TEXT,
    customerId TEXT,
    customerName TEXT,
    customerContactNo TEXT,
    currentAddress TEXT,
    desiredDestination TEXT,
    status TEXT NOT NULL CHECK(&quot;status&quot; IN ('Pending', 'Contacted', 'Not interested', 'Qoutation', 'Group Trip', 'Refund', 'Confirmed')),
    source TEXT NOT NULL CHECK(&quot;source&quot; IN ('Facebook', 'WhatsApp', 'Reference', 'TikTok', 'Instagram', 'Lead Form', 'Other')),
    amountClosed REAL,
    createdAt TEXT,
    updatedAt TEXT
);



-- Migrate data from backup to new leads table with status and source updates
INSERT INTO leads (employeeLeadId, employeeId, employeeName, employeeContactNo, customerId, customerName, customerContactNo, currentAddress, desiredDestination, status, source, amountClosed, createdAt, updatedAt)
SELECT 
    employeeLeadId, 
    employeeId, 
    employeeName, 
    employeeContactNo, 
    customerId, 
    customerName, 
    customerContactNo, 
    currentAddress, 
    desiredDestination,
    CASE status
        WHEN 'Lost' THEN 'Not interested'
        WHEN 'Willing' THEN 'Qoutation'
        WHEN 'Paid' THEN 'Group Trip'
        ELSE status
    END AS status,
    CASE 
        WHEN source NOT IN ('Facebook', 'WhatsApp', 'Reference', 'TikTok', 'Instagram', 'Lead Form', 'Other') THEN 'Other'
        ELSE source
    END AS source,
    amountClosed,
    createdAt,
    updatedAt
FROM leads_backup;



-- Drop the backup tables
DROP TABLE leads_backup;</sql><current_tab id="0"/></tab_sql></sqlb_project>
